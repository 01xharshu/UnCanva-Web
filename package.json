    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
